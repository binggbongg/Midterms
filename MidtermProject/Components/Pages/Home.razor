@page "/"
@using MidtermProject.Models
@using MidtermProject.Services
@rendermode InteractiveServer
@inject IMovieRouletteService RouletteService
@inject IWatchlistService Watchlist

<div class="mx-auto flex max-w-4xl flex-col items-center px-6 pb-16 pt-6 md:pt-10">

    <!-- Hero -->
    <h1 class="mb-8 text-center md:mb-10">
        <span class="block text-3xl font-bold uppercase tracking-tight md:text-5xl">Stop scrolling</span>
        <span class="mt-2 block text-4xl font-bold tracking-tight md:text-7xl">Let fate choose your film.</span>
    </h1>

    <!-- Filter card -->
    <div class="w-full rounded-[28px] bg-olive p-6 md:p-10">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-6">

            <div>
                <label for="genre" class="field-label">Genre</label>
                <select id="genre" @bind="selectedGenre" class="select-pill">
                    <option value="">Any Genre</option>
                    <option value="Action">Action</option>
                    <option value="Comedy">Comedy</option>
                    <option value="Drama">Drama</option>
                    <option value="Horror">Horror</option>
                    <option value="Musical">Musical</option>
                    <option value="Mystery">Mystery</option>
                    <option value="Romance">Romance</option>
                    <option value="Sci-Fi">Sci-Fi</option>
                    <option value="Thriller">Thriller</option>
                </select>
            </div>

            <div>
                <label for="platform" class="field-label">Platform</label>
                <select id="platform" @bind="selectedPlatform" class="select-pill">
                    <option value="">Any Platform</option>
                    <option value="Netflix">Netflix</option>
                    <option value="Prime Video">Prime Video</option>
                    <option value="HBO Max">HBO Max</option>
                </select>
            </div>

            <div>
                <label for="length" class="field-label">Length</label>
                <select id="length" @bind="maxRuntime" class="select-pill">
                    <option value="0">Any Length</option>
                    <option value="90">Under 90 Mins</option>
                    <option value="120">Under 2 Hours</option>
                    <option value="150">Under 2.5 Hours</option>
                </select>
            </div>
        </div>

        <button @onclick="SpinWheelAsync"
                disabled="@isSpinning"
                class="btn-pill mx-auto mt-8 flex w-full max-w-sm bg-rust py-3.5 text-lg text-ink">
            @if (isSpinning)
            {
                <span class="size-4 animate-spin rounded-full border-2 border-ink border-t-transparent motion-reduce:animate-none" aria-hidden="true"></span>
                <span>Spinning</span>
            }
            else
            {
                <span>SPIN</span>
            }
        </button>
    </div>

    <!-- Result -->
    <div aria-live="polite" class="mt-10 w-full">
        @if (selectedItem != null)
        {
            <div class="animate-fade-in overflow-hidden rounded-[28px] bg-navy text-cream motion-reduce:animate-none">
                <div class="md:flex">
                    <div class="relative h-72 overflow-hidden bg-ink/40 md:h-auto md:w-1/3">
                        <img src="@selectedItem.PosterUrl"
                             alt="@selectedItem.Title"
                             class="h-full w-full object-cover" />
                        <span class="absolute left-3 top-3 rounded-full bg-lime px-3 py-1 text-xs font-bold text-ink">
                            @selectedItem.StreamingPlatform
                        </span>
                    </div>

                    <div class="flex flex-col justify-between gap-6 p-6 md:w-2/3 md:p-8">
                        <div>
                            <p class="flex flex-wrap gap-x-4 text-sm font-bold text-lime">
                                <span>@selectedItem.Genre</span>
                                <span>@selectedItem.ReleaseYear</span>
                            </p>
                            <h2 class="mt-1 text-3xl font-bold leading-tight tracking-tight md:text-4xl">
                                @selectedItem.Title
                            </h2>
                            <p class="mt-3 max-w-prose text-sm leading-relaxed text-cream/85 md:text-base">
                                @selectedItem.Synopsis
                            </p>
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-cream/20 pt-4">
                            <p class="text-sm text-cream/85">
                                Runtime: <strong class="text-lime">@selectedItem.GetDurationDisplay()</strong>
                            </p>
                            @if (Watchlist.Contains(selectedItem.Id))
                            {
                                <button @onclick="() => Watchlist.Remove(selectedItem.Id)"
                                        class="btn-pill border-2 border-cream px-5 py-2 text-sm text-cream hover:bg-cream hover:text-navy">
                                    In Watchlist, remove
                                </button>
                            }
                            else
                            {
                                <button @onclick="() => Watchlist.Add(selectedItem)"
                                        class="btn-pill bg-rust px-5 py-2 text-sm text-ink">
                                    Add to Watchlist
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (hasSpun && !isSpinning)
        {
            <div class="mx-auto max-w-md rounded-3xl border-2 border-dashed border-ink/30 p-6 text-center">
                <p class="font-bold">No matches found</p>
                <p class="mt-1 text-sm text-ink/70">Pick a different genre, platform or length and spin again.</p>
            </div>
        }
    </div>

</div>

@code {
    private string selectedGenre = "";
    private string selectedPlatform = "";
    private int maxRuntime = 0;

    private MediaItem? selectedItem;
    private bool hasSpun = false;
    private bool isSpinning = false;

    private async Task SpinWheelAsync()
    {
        isSpinning = true;
        hasSpun = true;
        selectedItem = null;

        // Brief delay to give an engaging "rolling" feel
        await Task.Delay(600);

        selectedItem = RouletteService.SpinRoulette(selectedGenre, selectedPlatform, maxRuntime);
        isSpinning = false;
    }
}
